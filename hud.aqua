變數 繪圖模組 = 匯入("Processing");
變數 設定模組 = 匯入(目前工作目錄 + "/config.aqua");
變數 文 = 字串;
# 介面分成兩層：不常變動的面板、說明、地圖與檢查點快取在透明畫布，只在狀態或尺寸改變時重繪；
# 每畫格只繪製快取圖層、時間、速度與小地圖上的彈珠，大幅減少繪製呼叫。
變數 賽道資料 = 0;
變數 字型 = 0;
變數 介面畫布 = 0;
變數 快取鍵 = "";
變數 畫質文字 = "";
變數 設定畫質文字 = 函式(文字) { 畫質文字 = 文字; };
變數 初始化 = 函式(新賽道資料) {
    賽道資料 = 新賽道資料;
    字型 = 繪圖模組.建立字型("Microsoft JhengHei", 16);
    繪圖模組.文字字型(字型);
    介面畫布 = 繪圖模組.建立畫布(繪圖模組.width, 繪圖模組.height);
};
變數 繪製面板 = 函式(畫, 橫向座標, 垂直座標, 面板寬度, 面板高度) {
    畫.停用描邊(); 畫.填色(10, 18, 30, 205); 畫.矩形(橫向座標, 垂直座標, 面板寬度, 面板高度, 12);
};
變數 繪製文字 = 函式(畫, 數值, 橫向座標, 垂直座標, 字級, 色彩) {
    畫.填色(色彩[0], 色彩[1], 色彩[2]); 畫.文字大小(字級); 畫.文字(數值, 橫向座標, 垂直座標);
};
# 逐字繪製每畫格變動的數字：每個字元的文字紋理只點陣化一次並重複使用，避免每畫格重新讀回畫布像素。
變數 繪製數字 = 函式(畫, 數值, 橫向座標, 垂直座標, 字級, 色彩) {
    變數 文字 = 文.轉文字(數值);
    畫.填色(色彩[0], 色彩[1], 色彩[2]); 畫.文字大小(字級);
    變數 位置 = 橫向座標;
    迴圈 (變數 索引 = 0; 索引 < 長度(文字); 索引++) {
        變數 字 = 文.切片(文字, 索引, 索引 + 1);
        畫.文字(字, 位置, 垂直座標);
        位置 += 畫.文字寬度(字);
    }
};
變數 白色 = [235, 242, 247];
變數 柔和色 = [150, 170, 188];
變數 藍綠色 = [76, 213, 189];
變數 金色 = [255, 190, 80];
變數 取秒數 = 函式(數值) { 回傳 繪圖模組.向下取整(數值*100)/100.0d; };
變數 窄版 = 函式() { 回傳 繪圖模組.width < 760; };
變數 介面縮放 = 函式() { 回傳 繪圖模組.最小值(繪圖模組.width*1.0d/設定模組.視窗寬度, 繪圖模組.height*1.0d/設定模組.視窗高度); };
變數 套用版面 = 函式(畫) {
    變數 比例 = 介面縮放();
    畫.平移((繪圖模組.width-設定模組.視窗寬度*比例)/2, (繪圖模組.height-設定模組.視窗高度*比例)/2); 畫.縮放(比例);
};
變數 小地圖座標 = 函式(位置) { 回傳 [1180+位置[0]*7, 185+(22-位置[2])*2.4d]; };

變數 繪製窄版靜態 = 函式(畫, 狀態資料) {
    變數 寬 = 繪圖模組.width; 變數 高 = 繪圖模組.height;
    繪製面板(畫, 12, 12, 寬-24, 94);
    繪製文字(畫, "彈珠競速", 28, 42, 22, 白色);
    繪製文字(畫, "時間", 28, 70, 14, 柔和色);
    繪製文字(畫, "速度", 寬/2, 70, 14, 柔和色);
    繪製文字(畫, 畫質文字, 寬-140, 42, 11, 柔和色);
    繪製面板(畫, 28, 高-156, 124, 124); 繪製文字(畫, "轉向", 66, 高-86, 18, 白色);
    繪製面板(畫, 寬-132, 高-136, 104, 104); 繪製文字(畫, "煞車", 寬-108, 高-76, 18, 金色);
    如果 (狀態資料["finished"]) {
        繪製面板(畫, 12, 124, 寬-24, 100); 繪製文字(畫, "完成賽道", 28, 164, 24, 金色);
        繪製文字(畫, 取秒數(狀態資料["elapsed"]), 28, 200, 22, 白色);
    }
};
變數 繪製寬版靜態 = 函式(畫, 狀態資料, 鏡頭資料) {
    畫.推入矩陣();
    套用版面(畫);
    繪製面板(畫, 24, 24, 346, 96);
    繪製文字(畫, "彈珠競速", 44, 61, 28, 白色);
    繪製文字(畫, "高空速降", 45, 88, 12, 藍綠色);
    繪製文字(畫, "PBR 光影 + Jolt 物理引擎", 45, 107, 11, 柔和色);
    繪製面板(畫, 842, 24, 414, 96);
    繪製文字(畫, "時間／秒", 865, 49, 11, 柔和色);
    繪製文字(畫, "速度／公尺每秒", 1004, 49, 11, 柔和色);
    繪製文字(畫, "墜落次數", 1155, 49, 11, 柔和色);
    繪製文字(畫, 狀態資料["falls"], 1155, 88, 30, 金色);
    繪製面板(畫, 1104, 140, 152, 232);
    繪製文字(畫, "賽道地圖", 1120, 164, 12, 柔和色);
    變數 節點資料列表 = 賽道資料["nodes"];
    畫.描邊(51, 82, 101); 畫.描邊粗細(4);
    迴圈 (變數 索引 = 0; 索引 < 長度(節點資料列表)-1; 索引++) {
        變數 甲 = 小地圖座標(節點資料列表[索引]); 變數 乙 = 小地圖座標(節點資料列表[索引+1]);
        畫.線段(甲[0], 甲[1], 乙[0], 乙[1]);
    }
    畫.停用描邊();
    迴圈 (變數 索引 = 0; 索引 < 長度(節點資料列表); 索引++) {
        變數 座標 = 小地圖座標(節點資料列表[索引]); 畫.填色(62, 100, 122);
        如果 (索引 <= 狀態資料["checkpoint"]) { 畫.填色(76, 213, 189); }
        畫.圓形(座標[0], 座標[1], 8);
    }
    如果 (鏡頭資料["overview"]) { 繪製文字(畫, "俯瞰鏡頭", 1120, 353, 11, 金色); }
    否則 { 繪製文字(畫, "跟隨鏡頭", 1120, 353, 11, 柔和色); }
    繪製面板(畫, 24, 692, 1232, 84);
    繪製文字(畫, "WASD／方向鍵  轉向     空白鍵  煞車     J  跳躍", 44, 722, 15, 白色);
    繪製文字(畫, "R  重生（加罰 3 秒）     Enter  重新開始     P  暫停     C  切換鏡頭     Q  畫質     滾輪  縮放     Esc  離開", 44, 751, 13, 柔和色);
    繪製文字(畫, 畫質文字, 1120, 751, 13, 柔和色);
    變數 檢查門數量 = 長度(賽道資料["gates"]);
    # 寫實地面較亮，檢查點與最佳成績放在半透明底板上才容易辨識。
    繪製面板(畫, 16, 636, 120+檢查門數量*42, 36);
    繪製文字(畫, "檢查點", 28, 660, 11, 柔和色);
    迴圈 (變數 索引 = 0; 索引 < 檢查門數量; 索引++) {
        畫.填色(34, 54, 73); 如果 (索引 < 狀態資料["checkpoint"]) { 畫.填色(76, 213, 189); }
        畫.矩形(134+索引*42, 645, 32, 17, 4);
    }
    如果 (狀態資料["best"] > 0) {
        繪製面板(畫, 1043, 636, 213, 36);
        繪製文字(畫, "本次最佳／秒", 1055, 659, 11, 柔和色);
        繪製文字(畫, 取秒數(狀態資料["best"]), 1190, 659, 16, 藍綠色);
    }
    如果 (!狀態資料["started"] && !狀態資料["finished"]) {
        繪製面板(畫, 400, 142, 480, 96);
        繪製文字(畫, "依序通過金色檢查門", 424, 175, 20, 白色);
        繪製文字(畫, "按 W／上方向鍵出發，轉彎時調整方向。", 424, 202, 14, 柔和色);
        繪製文字(畫, "利用重力滑行，入彎前記得煞車。", 424, 222, 13, 藍綠色);
    }
    如果 (狀態資料["paused"]) {
        繪製面板(畫, 450, 306, 380, 116);
        繪製文字(畫, "已暫停", 488, 351, 32, 金色);
        繪製文字(畫, "按 P 繼續遊戲", 488, 390, 16, 白色);
    }
    如果 (狀態資料["finished"]) {
        繪製面板(畫, 412, 262, 456, 242);
        變數 獎牌名稱 = "完賽"; 變數 色彩 = 藍綠色;
        如果 (狀態資料["elapsed"] <= 設定模組.金牌時間) { 獎牌名稱 = "金牌"; 色彩 = 金色; }
        否則如果 (狀態資料["elapsed"] <= 設定模組.銀牌時間) { 獎牌名稱 = "銀牌"; 色彩 = 白色; }
        繪製文字(畫, "完成賽道", 442, 305, 26, 白色);
        繪製文字(畫, 獎牌名稱, 443, 343, 20, 色彩);
        繪製文字(畫, "總時間（含墜落罰時）／秒", 443, 373, 11, 柔和色);
        繪製文字(畫, 取秒數(狀態資料["elapsed"]), 443, 418, 38, 色彩);
        繪製文字(畫, "按 Enter 再挑戰一次", 443, 458, 17, 白色);
        繪製文字(畫, "金牌：24 秒內／銀牌：38 秒內", 443, 484, 12, 柔和色);
    }
    畫.彈出矩陣();
};
變數 快取內容 = 函式(狀態資料, 鏡頭資料) {
    變數 完賽時間 = 0;
    如果 (狀態資料["finished"]) { 完賽時間 = 取秒數(狀態資料["elapsed"]); }
    回傳 文.合併([繪圖模組.width, 繪圖模組.height, 繪圖模組.pixelWidth, 繪圖模組.pixelHeight, 狀態資料["checkpoint"],
        狀態資料["falls"], 狀態資料["started"], 狀態資料["paused"], 狀態資料["finished"], 取秒數(狀態資料["best"]),
        鏡頭資料["overview"], 畫質文字, 完賽時間], "|");
};
變數 更新快取 = 函式(狀態資料, 鏡頭資料) {
    變數 鍵 = 快取內容(狀態資料, 鏡頭資料);
    如果 (鍵 == 快取鍵) { 回傳 假; }
    快取鍵 = 鍵;
    如果 (介面畫布.width != 繪圖模組.width || 介面畫布.height != 繪圖模組.height ||
        介面畫布.pixelWidth != 繪圖模組.pixelWidth || 介面畫布.pixelHeight != 繪圖模組.pixelHeight) {
        介面畫布.調整尺寸(繪圖模組.width, 繪圖模組.height, 繪圖模組.pixelWidth, 繪圖模組.pixelHeight);
    }
    介面畫布.開始繪圖();
    介面畫布.清除();
    介面畫布.文字字型(字型);
    如果 (窄版()) { 繪製窄版靜態(介面畫布, 狀態資料); } 否則 { 繪製寬版靜態(介面畫布, 狀態資料, 鏡頭資料); }
    介面畫布.結束繪圖();
    回傳 真;
};
變數 繪製畫面 = 函式(狀態資料, 鏡頭資料) {
    更新快取(狀態資料, 鏡頭資料);
    繪圖模組.圖片(介面畫布, 0, 0, 繪圖模組.width, 繪圖模組.height);
    如果 (窄版()) {
        繪製數字(繪圖模組, 取秒數(狀態資料["elapsed"]), 72, 74, 18, 藍綠色);
        繪製數字(繪圖模組, 取秒數(狀態資料["speed"]), 繪圖模組.width/2+44, 74, 18, 白色);
        回傳 真;
    }
    繪圖模組.推入矩陣();
    套用版面(繪圖模組);
    繪製數字(繪圖模組, 取秒數(狀態資料["elapsed"]), 863, 88, 30, 白色);
    繪製數字(繪圖模組, 繪圖模組.向下取整(狀態資料["speed"]*10)/10.0d, 1003, 88, 30, 藍綠色);
    變數 位置 = 狀態資料["position"];
    變數 座標 = 小地圖座標([繪圖模組.限制範圍(位置[0], -8, 8), 0, 繪圖模組.限制範圍(位置[2], -40, 24)]);
    繪圖模組.停用描邊(); 繪圖模組.填色(255, 126, 86);
    繪圖模組.圓形(座標[0], 座標[1], 10);
    繪圖模組.彈出矩陣();
    回傳 真;
};
