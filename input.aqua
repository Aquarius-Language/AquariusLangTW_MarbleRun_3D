變數 繪圖模組 = 匯入("Processing");
變數 讀取按鍵 = 函式() {
    變數 橫向分量 = 0.0d; 變數 縱向分量 = 0.0d;
    如果 (繪圖模組.keyDown(65) || 繪圖模組.keyDown(263)) { 橫向分量 -= 1; }
    如果 (繪圖模組.keyDown(68) || 繪圖模組.keyDown(262)) { 橫向分量 += 1; }
    如果 (繪圖模組.keyDown(87) || 繪圖模組.keyDown(265)) { 縱向分量 -= 1; }
    如果 (繪圖模組.keyDown(83) || 繪圖模組.keyDown(264)) { 縱向分量 += 1; }
    變數 輸入向量長度 = 繪圖模組.sqrt(橫向分量*橫向分量+縱向分量*縱向分量);
    如果 (輸入向量長度 > 1) { 橫向分量 = 橫向分量/輸入向量長度; 縱向分量 = 縱向分量/輸入向量長度; }
    回傳 [橫向分量, 縱向分量, 繪圖模組.keyDown(32)];
};
