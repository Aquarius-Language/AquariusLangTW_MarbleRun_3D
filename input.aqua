變數 繪圖模組 = 匯入("Processing");
變數 讀取按鍵 = 函式() {
    變數 橫向分量 = 0.0d; 變數 縱向分量 = 0.0d;
    如果 (繪圖模組.按鍵是否按下(65) || 繪圖模組.按鍵是否按下(263)) { 橫向分量 -= 1; }
    如果 (繪圖模組.按鍵是否按下(68) || 繪圖模組.按鍵是否按下(262)) { 橫向分量 += 1; }
    如果 (繪圖模組.按鍵是否按下(87) || 繪圖模組.按鍵是否按下(265)) { 縱向分量 -= 1; }
    如果 (繪圖模組.按鍵是否按下(83) || 繪圖模組.按鍵是否按下(264)) { 縱向分量 += 1; }
    變數 煞車 = 繪圖模組.按鍵是否按下(32);
    如果 (繪圖模組.isMousePressed) {
        變數 寬 = 繪圖模組.width; 變數 高 = 繪圖模組.height;
        如果 (繪圖模組.mouseY >= 高 - 180 && 繪圖模組.mouseX < 寬 / 2) {
            橫向分量 = 繪圖模組.限制範圍((繪圖模組.mouseX - 90) / 55.0d, -1, 1);
            縱向分量 = 繪圖模組.限制範圍((繪圖模組.mouseY - 高 + 90) / 55.0d, -1, 1);
        } 否則如果 (繪圖模組.mouseY >= 高 - 150) { 煞車 = 真; }
    }
    變數 輸入向量長度 = 繪圖模組.平方根(橫向分量*橫向分量+縱向分量*縱向分量);
    如果 (輸入向量長度 > 1) { 橫向分量 = 橫向分量/輸入向量長度; 縱向分量 = 縱向分量/輸入向量長度; }
    回傳 [橫向分量, 縱向分量, 煞車];
};
