變數 P = 匯入("Processing");
變數 Add = 函式(a, b) { 回傳 [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; };
變數 Sub = 函式(a, b) { 回傳 [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; };
變數 Scale = 函式(a, s) { 回傳 [a[0] * s, a[1] * s, a[2] * s]; };
變數 Length = 函式(a) { 回傳 P.sqrt(a[0]*a[0] + a[1]*a[1] + a[2]*a[2]); };
# Rotate a vector with a unit quaternion, matching Jolt's [x,y,z,w].
變數 Rotate = 函式(q, v) {
    變數 tx = 2 * (q[1]*v[2] - q[2]*v[1]);
    變數 ty = 2 * (q[2]*v[0] - q[0]*v[2]);
    變數 tz = 2 * (q[0]*v[1] - q[1]*v[0]);
    回傳 [v[0]+q[3]*tx+q[1]*tz-q[2]*ty,
          v[1]+q[3]*ty+q[2]*tx-q[0]*tz,
          v[2]+q[3]*tz+q[0]*ty-q[1]*tx];
};
變數 InverseRotate = 函式(q, v) { 回傳 Rotate([-q[0], -q[1], -q[2], q[3]], v); };
變數 Along = 函式(delta) {
    變數 yaw = P.atan2(delta[0], delta[2]);
    變數 pitch = -P.atan2(delta[1], P.sqrt(delta[0]*delta[0] + delta[2]*delta[2]));
    變數 sx = P.sin(pitch / 2); 變數 cx = P.cos(pitch / 2);
    變數 sy = P.sin(yaw / 2); 變數 cy = P.cos(yaw / 2);
    回傳 [cy*sx, sy*cx, -sy*sx, cy*cx];
};
# Column-major matrix for Processing.applyMatrix; translation is separate.
變數 Matrix = 函式(q) {
    變數 x = q[0]; 變數 y = q[1]; 變數 z = q[2]; 變數 w = q[3];
    回傳 [1-2*(y*y+z*z), 2*(x*y+z*w), 2*(x*z-y*w), 0,
          2*(x*y-z*w), 1-2*(x*x+z*z), 2*(y*z+x*w), 0,
          2*(x*z+y*w), 2*(y*z-x*w), 1-2*(x*x+y*y), 0,
          0, 0, 0, 1];
};
