# 繪圖管線：HDR 場景畫布（rgba16float）→ 光暈擷取 → ACES 色調映射與 FXAA 合成至主畫面。
# 靜態幾何在初始化時建立為保留網格；每畫格只更新相機與彈珠參數，繪製約十次。
變數 繪圖模組 = 匯入("Processing");
變數 圖形處理模組 = 匯入("WGPU");
變數 設定模組 = 匯入(目前工作目錄 + "/config.aqua");
變數 數學模組 = 匯入(目前工作目錄 + "/math3d.aqua");
變數 環境模組 = 匯入(目前工作目錄 + "/environment.aqua");
變數 幾何模組 = 匯入(目前工作目錄 + "/geometry.aqua");
變數 著色器模組 = 匯入(目前工作目錄 + "/shaders.aqua");
變數 旋轉矩陣 = 數學模組.旋轉矩陣; 變數 矩陣相乘 = 數學模組.矩陣相乘;
變數 透視投影 = 數學模組.透視投影; 變數 觀察矩陣 = 數學模組.觀察矩陣;

變數 場景畫布 = 0; 變數 光暈畫布 = 0; 變數 遮罩畫布 = 0;
變數 網格 = 0;
變數 場景材質 = 0; 變數 彈珠材質 = 0; 變數 天空材質 = 0;
變數 合成材質 = 0; 變數 光暈擷取材質 = 0; 變數 光暈疊加材質 = 0;
變數 天空立方體 = 0;
變數 開始時間 = 0.0d;

# 畫質：0 自動、1 高、2 中、3 低。自動模式依畫格時間調整渲染比例。
變數 畫質模式 = 0;
變數 畫質名稱 = ["自動", "高", "中", "低"];
變數 自動比例 = 1.0d;
變數 平均畫格毫秒 = 16.7d;
變數 前次毫秒 = -1.0d;
變數 已繪畫格 = 0;
變數 上次調整畫格 = 0;
變數 目前像素寬 = 0; 變數 目前像素高 = 0;

變數 載入貼圖 = 函式(名稱, 尺寸, 格式, 維度, 層數) {
    回傳 場景畫布.載入紋理("assets/" + 名稱 + ".gz", 尺寸, 尺寸, 格式, 維度, 層數);
};
變數 初始化 = 函式(賽道資料) {
    開始時間 = 繪圖模組.毫秒() / 1000.0d;
    場景畫布 = 繪圖模組.建立畫布(繪圖模組.width, 繪圖模組.height, 繪圖模組.P3D, "rgba16float");
    光暈畫布 = 繪圖模組.建立畫布(64, 64, 繪圖模組.P2D, "rgba16float");
    變數 太陽 = 數學模組.正規化(環境模組.太陽方向);
    網格 = 幾何模組.建立(場景畫布, 賽道資料, 太陽);
    天空立方體 = 網格["proxy"];
    變數 範圍 = 網格["maskRange"];
    遮罩畫布 = 繪圖模組.建立畫布(範圍[4], 範圍[5]);
    幾何模組.繪製地面遮罩(遮罩畫布, 網格["boxes"], 範圍, 太陽);
    變數 原始碼 = 著色器模組.建立場景著色器(網格["occluders"], 範圍);
    場景材質 = 場景畫布.建立著色器(原始碼["scene"][0], 原始碼["scene"][1]);
    彈珠材質 = 場景畫布.建立著色器(原始碼["marble"][0], 原始碼["marble"][1]);
    天空材質 = 場景畫布.建立著色器(原始碼["sky"][0], 原始碼["sky"][1]);
    合成材質 = 繪圖模組.建立著色器(原始碼["composite"][0], 原始碼["composite"][1]);
    光暈擷取材質 = 光暈畫布.建立著色器(原始碼["bloomExtract"][0], 原始碼["bloomExtract"][1]);
    光暈疊加材質 = 繪圖模組.建立著色器(原始碼["bloomAdd"][0], 原始碼["bloomAdd"][1]);
    場景畫布.開始繪圖();
    變數 混凝土 = 環境模組.材質貼圖["concrete"]; 變數 草地 = 環境模組.材質貼圖["grass"];
    變數 環境 = 載入貼圖("env_specular", 環境模組.反射貼圖尺寸, "rgba16float", "cube", 環境模組.反射貼圖層數);
    場景材質.設定紋理("環境貼圖", 環境); 彈珠材質.設定紋理("環境貼圖", 環境); 天空材質.設定紋理("環境貼圖", 環境);
    場景材質.設定紋理("混凝土反照率", 載入貼圖("concrete_albedo", 混凝土[0], "rgba8unorm-srgb", "2d", 混凝土[1]));
    場景材質.設定紋理("混凝土法線", 載入貼圖("concrete_normal", 混凝土[0], "rgba8unorm", "2d", 混凝土[1]));
    場景材質.設定紋理("草地反照率", 載入貼圖("grass_albedo", 草地[0], "rgba8unorm-srgb", "2d", 草地[1]));
    場景材質.設定紋理("草地法線", 載入貼圖("grass_normal", 草地[0], "rgba8unorm", "2d", 草地[1]));
    天空材質.設定紋理("天空貼圖", 載入貼圖("sky", 環境模組.天空貼圖尺寸, "rgba8unorm", "2d", 1));
    場景畫布.結束繪圖();
    印出("彈珠競速繪圖後端：", 圖形處理模組.Backend, "／Processing", 繪圖模組.backend);
};

變數 切換畫質 = 函式() {
    畫質模式 = 畫質模式 + 1;
    如果 (畫質模式 > 3) { 畫質模式 = 0; }
    自動比例 = 1.0d; 上次調整畫格 = 已繪畫格;
};
變數 畫質等級 = 函式() {
    如果 (畫質模式 == 0) {
        如果 (自動比例 < 0.62d) { 回傳 3; }
        如果 (自動比例 < 0.8d) { 回傳 2; }
        回傳 1;
    }
    回傳 畫質模式;
};
變數 取得畫質描述 = 函式() {
    變數 比例 = 0;
    如果 (目前像素寬 > 0 && 繪圖模組.pixelWidth > 0) { 比例 = 繪圖模組.四捨五入(目前像素寬 * 100.0d / 繪圖模組.pixelWidth); }
    回傳 "畫質 " + 畫質名稱[畫質模式] + " " + 字串.轉文字(比例) + "%";
};
# 依平均畫格時間調整渲染比例；忽略啟動時的編譯與上傳畫格。
變數 更新自動畫質 = 函式() {
    變數 現在 = 繪圖模組.毫秒() * 1.0d;
    如果 (前次毫秒 >= 0) {
        變數 間隔 = 繪圖模組.限制範圍(現在 - 前次毫秒, 1, 250);
        平均畫格毫秒 = 平均畫格毫秒 * 0.92d + 間隔 * 0.08d;
    }
    前次毫秒 = 現在; 已繪畫格++;
    如果 (畫質模式 != 0 || 已繪畫格 < 90 || 已繪畫格 - 上次調整畫格 < 45) { 回傳 假; }
    如果 (平均畫格毫秒 > 20.5d && 自動比例 > 設定模組.渲染比例下限) {
        自動比例 = 繪圖模組.最大值(設定模組.渲染比例下限, 自動比例 * 0.86d); 上次調整畫格 = 已繪畫格;
    } 否則如果 (平均畫格毫秒 < 17.6d && 自動比例 < 1.0d && 已繪畫格 - 上次調整畫格 > 300) {
        自動比例 = 繪圖模組.最小值(1.0d, 自動比例 * 1.08d); 上次調整畫格 = 已繪畫格;
    }
    回傳 真;
};
# 渲染解析度：以實體像素為基準，依畫質上限與自動比例縮放。
變數 更新畫布尺寸 = 函式() {
    變數 等級 = 畫質等級();
    變數 實體寬 = 繪圖模組.pixelWidth; 變數 實體高 = 繪圖模組.pixelHeight;
    變數 上限 = 設定模組.最大渲染像素[等級 - 1] * 1.0d;
    變數 比例 = 繪圖模組.最小值(1.0d, 繪圖模組.平方根(上限 / 繪圖模組.最大值(1, 實體寬 * 實體高)));
    如果 (畫質模式 == 0) { 比例 = 比例 * 自動比例; }
    # resize 需要整數尺寸。
    變數 寬 = 繪圖模組.向下取整(繪圖模組.最大值(16, 實體寬 * 比例));
    變數 高 = 繪圖模組.向下取整(繪圖模組.最大值(16, 實體高 * 比例));
    如果 (寬 != 目前像素寬 || 高 != 目前像素高 || 場景畫布.width != 繪圖模組.width || 場景畫布.height != 繪圖模組.height) {
        場景畫布.調整尺寸(繪圖模組.width, 繪圖模組.height, 寬, 高);
        光暈畫布.調整尺寸(繪圖模組.向下取整(繪圖模組.最大值(8, 寬 / 4.0d)), 繪圖模組.向下取整(繪圖模組.最大值(8, 高 / 4.0d)));
        目前像素寬 = 寬; 目前像素高 = 高;
    }
};
變數 繪製場景 = 函式(狀態資料, 鏡頭資料) {
    變數 視點 = 鏡頭資料["eye"]; 變數 目標 = 鏡頭資料["target"];
    變數 長寬比 = 繪圖模組.width * 1.0d / 繪圖模組.最大值(1, 繪圖模組.height);
    變數 投影 = 透視投影(繪圖模組.PI / 3, 長寬比, 0.1d, 2500);
    變數 觀察 = 觀察矩陣(視點, 目標, [0, 1, 0]);
    變數 視投影 = 矩陣相乘(投影, 觀察);
    變數 天空觀察 = [觀察[0], 觀察[1], 觀察[2], 0, 觀察[4], 觀察[5], 觀察[6], 0, 觀察[8], 觀察[9], 觀察[10], 0, 0, 0, 0, 1];
    變數 時間 = 繪圖模組.毫秒() / 1000.0d - 開始時間;
    變數 位置 = 狀態資料["position"];
    變數 相機 = [視點[0], 視點[1], 視點[2], 時間];
    變數 彈珠 = [位置[0], 位置[1], 位置[2], 設定模組.彈珠半徑];
    變數 已完成 = 0; 如果 (狀態資料["finished"]) { 已完成 = 1; }
    變數 等級 = 畫質等級();
    場景畫布.開始繪圖();
    場景畫布.背景(0);
    場景畫布.停用描邊();
    場景畫布.著色器(場景材質);
    場景材質.設定("視投影", 視投影); 場景材質.設定("相機", 相機); 場景材質.設定("彈珠", 彈珠);
    # 由近而遠繪製以利深度提早剔除：結構、彈珠、地面，最後是天空。
    變數 繪製清單 = [["floors", 1], ["rails", 2], ["trim", 4], ["concrete", 3], ["markings", 5]];
    迴圈 (變數 索引 = 0; 索引 < 長度(繪製清單); 索引++) {
        場景材質.設定("參數", [繪製清單[索引][1], 狀態資料["checkpoint"], 已完成, 等級]);
        場景畫布.圖形(網格[繪製清單[索引][0]]);
    }
    場景畫布.著色器(彈珠材質);
    彈珠材質.設定("視投影", 視投影); 彈珠材質.設定("相機", 相機); 彈珠材質.設定("彈珠", 彈珠);
    彈珠材質.設定("參數", [0, 狀態資料["checkpoint"], 已完成, 等級]);
    彈珠材質.設定("旋轉", 旋轉矩陣(狀態資料["rotation"]));
    場景畫布.圖形(天空立方體);
    # 遮罩範圍內的地面以 image() 繪製，讓著色器取樣陰影遮罩；範圍外使用一般網格。
    場景畫布.著色器(場景材質);
    場景材質.設定("參數", [0, 狀態資料["checkpoint"], 已完成, 等級]);
    場景畫布.圖片(遮罩畫布, 0, 0, 1, 1);
    場景材質.設定("參數", [6, 狀態資料["checkpoint"], 已完成, 等級]);
    場景畫布.圖形(網格["outerGround"]);
    # 天空最後繪製，只填滿深度仍為最遠處的像素。
    場景畫布.著色器(天空材質);
    天空材質.設定("天空視投影", 矩陣相乘(投影, 天空觀察)); 天空材質.設定("相機", 相機);
    場景畫布.圖形(天空立方體);
    場景畫布.重設著色器();
    場景畫布.結束繪圖();
};
變數 合成畫面 = 函式() {
    變數 等級 = 畫質等級();
    變數 寬 = 繪圖模組.width; 變數 高 = 繪圖模組.height;
    變數 紋素 = [1.0d / 目前像素寬, 1.0d / 目前像素高, 寬 * 1.0d / 繪圖模組.最大值(1, 高), 0];
    如果 (等級 < 3) {
        光暈畫布.開始繪圖();
        光暈畫布.著色器(光暈擷取材質);
        光暈擷取材質.設定("紋素", 紋素); 光暈擷取材質.設定("後製", [設定模組.光暈門檻, 0, 0, 0]);
        光暈畫布.圖片(場景畫布, 0, 0, 光暈畫布.width, 光暈畫布.height);
        光暈畫布.重設著色器();
        光暈畫布.結束繪圖();
    }
    繪圖模組.背景(0);
    繪圖模組.著色器(合成材質);
    變數 啟用抗鋸齒 = 1; 如果 (等級 == 3) { 啟用抗鋸齒 = 0; }
    合成材質.設定("紋素", 紋素); 合成材質.設定("後製", [設定模組.暗角強度, 啟用抗鋸齒, 0, 0]);
    繪圖模組.圖片(場景畫布, 0, 0, 寬, 高);
    如果 (等級 < 3) {
        繪圖模組.混色模式(繪圖模組.ADD);
        繪圖模組.著色器(光暈疊加材質);
        光暈疊加材質.設定("紋素", [1.0d / 光暈畫布.width, 1.0d / 光暈畫布.height, 0, 0]);
        光暈疊加材質.設定("後製", [設定模組.光暈強度, 0, 0, 0]);
        繪圖模組.圖片(光暈畫布, 0, 0, 寬, 高);
        繪圖模組.混色模式(繪圖模組.BLEND);
    }
    繪圖模組.重設著色器();
};
變數 繪製畫面 = 函式(狀態資料, 鏡頭資料) {
    更新自動畫質();
    更新畫布尺寸();
    繪製場景(狀態資料, 鏡頭資料);
    合成畫面();
};
