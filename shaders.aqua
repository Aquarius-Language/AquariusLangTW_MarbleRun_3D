# wgpu supplies VertexInput/VertexOutput and the processing uniform header.
# Correct Processing's screen-oriented Y projection for this Y-up world.
變數 Vertex = "
@vertex fn vs_main(input: VertexInput) -> VertexOutput {
    var output: VertexOutput;
    let world = processing.model * vec4<f32>(input.position, 1.0);
    var clip = processing.projection * processing.view * world;
    clip.y = -clip.y;
    clip.z = (clip.z + clip.w) * 0.5;
    output.position = clip;
    output.normal = normalize((processing.model * vec4<f32>(input.normal, 0.0)).xyz);
    output.eyePosition = world.xyz;
    // Built-in spheres have no UVs; use their local normals for a rolling band.
    output.uv = input.normal.xy;
    output.vertexColor = input.color;
    return output;
}";
變數 Fragment = "
struct UserUniforms { eye: vec4<f32>, marble: f32, shine: f32, };
@group(1) @binding(0) var<uniform> user: UserUniforms;
@fragment fn fs_main(input: VertexOutput) -> @location(0) vec4<f32> {
    let n = normalize(input.normal);
    let l = normalize(vec3<f32>(-0.4, 0.85, 0.3));
    let v = normalize(user.eye.xyz - input.eyePosition);
    let h = normalize(l + v);
    var albedo = input.vertexColor.rgb;
    if (user.marble > 0.5) {
        let stripe = smoothstep(0.18, 0.24, abs(input.uv.y));
        albedo = mix(vec3<f32>(0.98, 0.95, 0.82), albedo, stripe);
    }
    let diffuse = max(dot(n, l), 0.0);
    let rim = pow(1.0 - max(dot(n, v), 0.0), 3.0);
    let specular = pow(max(dot(n, h), 0.0), 64.0) * user.shine;
    var color = albedo * (0.32 + 0.68*diffuse) + vec3<f32>(0.9, 0.95, 1.0)*specular;
    color += vec3<f32>(0.08, 0.18, 0.23)*rim;
    let fog = 1.0 - exp(-length(user.eye.xyz-input.eyePosition)*0.008);
    color = mix(color, vec3<f32>(0.047, 0.082, 0.137), fog);
    return vec4<f32>(color, input.vertexColor.a);
}";
