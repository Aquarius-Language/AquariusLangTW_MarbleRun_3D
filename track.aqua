變數 C = 匯入(目前工作目錄 + "/config.aqua");
變數 M = 匯入(目前工作目錄 + "/math3d.aqua");
變數 Add = M.Add; 變數 Sub = M.Sub; 變數 Scale = M.Scale;
變數 Length = M.Length; 變數 Rotate = M.Rotate; 變數 Along = M.Along;
變數 Identity = [0, 0, 0, 1];
變數 Nodes = C.Nodes;
變數 Colors = C.TrackColors;
變數 Box = 函式(position, size, rotation, color) {
    回傳 {"position": position, "size": size, "rotation": rotation, "color": color};
};
變數 Build = 函式() {
    變數 Pieces = []; 變數 Ramps = []; 變數 Gates = [];
    迴圈 (變數 i = 0; i < 長度(Nodes)-1; i++) {
        變數 a = Nodes[i]; 變數 b = Nodes[i+1];
        變數 delta = Sub(b, a); 變數 distance = Length(delta); 變數 q = Along(delta);
        變數 center = Scale(Add(a, b), 0.5d);
        變數 colorIndex = i-(i/長度(Colors))*長度(Colors);
        變數 color = Colors[colorIndex];
        變數 floor = Box(Add(center, Rotate(q, [0, -C.TrackThickness/2, 0])),
            [C.TrackWidth, C.TrackThickness, distance+0.3d], q, color);
        Pieces = 加入(Pieces, floor);
        Ramps = 加入(Ramps, floor);
        # Rails stop before each junction, leaving room to steer around corners.
        迴圈 (變數 side = -1; side <= 1; side += 2) {
            Pieces = 加入(Pieces, Box(Add(center, Rotate(q, [side*(C.TrackWidth/2+0.05d), 0.3d, 0])),
                [0.16d, 0.6d, distance-2.0d], q, [26, 57, 76]));
        }
        Gates = 加入(Gates, b);
    }
    # Broad, flush landing pads bridge the bends and act as respawn platforms.
    迴圈 (變數 i = 0; i < 長度(Nodes); i++) {
        變數 n = Nodes[i];
        變數 pad = Box([n[0], n[1]-0.2d, n[2]], [4.0d, 0.4d, 4.0d], Identity, [38, 73, 93]);
        Pieces = 加入(Pieces, pad);
        Ramps = 加入(Ramps, pad);
        # Structural pillars also collide, so rendered and physical geometry agree.
        Pieces = 加入(Pieces, Box([n[0], (n[1]-0.45d)/2-1, n[2]],
            [0.65d, n[1]+1.55d, 0.65d], Identity, [23, 39, 55]));
    }
    變數 end = Nodes[長度(Nodes)-1];
    Pieces = 加入(Pieces, Box([end[0], end[1]+0.4d, end[2]-2], [4, 0.8d, 0.2d], Identity, [238, 176, 62]));
    回傳 {"pieces": Pieces, "ramps": Ramps, "gates": Gates, "nodes": Nodes};
};
